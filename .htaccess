# Kaada Group · configuration du serveur (Hostinger, LiteSpeed / Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Domaine unique : www.kaadagroup.com (le passage en HTTPS se règle dans hPanel › SSL › Forcer HTTPS)
  RewriteCond %{HTTP_HOST} ^kaadagroup\.com$ [NC]
  RewriteRule ^ https://www.kaadagroup.com%{REQUEST_URI} [L,R=301]
  # Adresses courtes : /sankora affiche sankora.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ /$1.html [L]
  # Fichiers internes jamais servis
  RewriteRule ^(README\.md|LISEZMOI\.md|netlify\.toml)$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml
</IfModule>
